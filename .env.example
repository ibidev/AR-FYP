# ============================================================
#  AR Digital Twin — environment variables
#  Chat uses a fallback chain: Groq 70B -> Groq 8B -> OpenAI.
#  Run /api/health after setting these to verify everything live.
# ============================================================

# --- LLM: Groq (primary + fast fallback share one key) ---
# Create a NON-EXPIRING key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- LLM: OpenAI (optional cross-provider fallback) ---
# Only activates if this is a real OpenAI key (starts with "sk-").
# Leave blank to run Groq-only. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- Voice: ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_turbo_v2_5 (fast, multilingual) or eleven_multilingual_v2 (higher quality, slower)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
